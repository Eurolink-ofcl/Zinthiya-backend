# PostgreSQL Connection
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/zinthiya_db?schema=public&connection_limit=25&pool_timeout=30"

# Application Port
PORT=5000
NODE_ENV=development

# Redis Connection (Optional / Cache)
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=7d
